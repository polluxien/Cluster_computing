C_FILES = $(wildcard src/*.c)
H_FILES = $(wildcard src/*.h)
TARGET  = dist/n-body-sim.out

build: $(TARGET)
run:   run/4
video: dist/points.mp4
zip:   dist/source.zip


.PHONY: run*
run/%: PROCESSOR_COUNT = $(@:run/%=%)
run/%: $(TARGET)
	@mpirun -n $(PROCESSOR_COUNT) $(TARGET) >> runlog.txt

# Create a video using FFMPEG from the generated image sequence.
# Images are generated by a run if the image generation flag was set.
dist/points.mp4:
	@ffmpeg -framerate 60 -pattern_type glob -i "dist/points-*.pgm" $@

# Zip the relevant source files.
dist/source.zip: clean
	@zip -r $@ src dist Makefile runlog.txt

.PHONY: clean
clean:
	@rm -rf ./dist
	@mkdir dist

$(TARGET): $(C_FILES) $(H_FILES)
	@mpicc -g -o $@ $^ -lm # -lraylib
